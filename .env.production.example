# Copy to a private .env and replace example.invalid with your controlled domain.
# TLS terminates in an authorized outer reverse proxy; preserve the original Host.
BG_ENV=production
BG_PUBLIC_URL=https://identity.example.invalid
BG_ALLOWED_HOSTS=identity.example.invalid,localhost,127.0.0.1
BG_BIND_ADDRESS=127.0.0.1
BG_WEB_PORT=5180
BG_SECRETS_DIR=./.secrets
BG_IMAGE_PREFIX=bakagateway
